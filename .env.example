# ============================================================
# Sierra Leone Immigration System (SLID) - Environment Template
# Copy this file to .env or backend/.env and fill in your actual credentials.
# NEVER commit real .env files to public repositories.
# ============================================================

# 1. SUPABASE CONFIGURATION (Database & Auth)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 2. SERVER & API CONFIGURATION
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://border-control-efficient-for-slid.vercel.app

# 3. AI CHATBOT & GEMINI API INTEGRATION
GEMINI_API_KEY=your_gemini_api_key_here

# 4. EMAIL & SMS GATEWAY CONFIGURATION (Optional Sandbox Mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_official_email@slid.gov.sl
SMTP_PASS=your_email_app_password
SMS_API_KEY=your_termii_or_twilio_sms_key_here
